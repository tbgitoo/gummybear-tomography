# Machine-local Hugging Face staging paths.
# Copy to configs/hf/local.toml (gitignored) and edit.
#
# Public Hub ids stay in plans/milestone_11/11_huggingface_artifacts_plan.md;
# only filesystem clones that live outside this git tree belong here.

[models.singleview_cnn_fourier]
hub_id = "tbhugging/singleview_cnn_fourier"
hub_url = "https://huggingface.co/tbhugging/singleview_cnn_fourier"
# Absolute path to a local `git clone` of the Hub model repo:
local_clone = "/path/to/local/clone/of/singleview_cnn_fourier"

[models.camera_orbit_compact_09_2b]
hub_id = "tbhugging/camera_orbit_compact_09_2b"
hub_url = "https://huggingface.co/tbhugging/camera_orbit_compact_09_2b"
local_clone = "/path/to/local/clone/of/camera_orbit_compact_09_2b"

[models.gummybear_hierarchical_fusion]
hub_id = "tbhugging/gummybear_hierarchical_fusion"
hub_url = "https://huggingface.co/tbhugging/gummybear_hierarchical_fusion"
local_clone = "/path/to/local/clone/of/gummybear_hierarchical_fusion"
